<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --ink:#1d1d1f; --muted:#5f6368; --line:#e3e5e8; --accent:#0a66c2; --bg:#ffffff; --card:#f7f8fa; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font-family:"Noto Sans CJK TC","Noto Sans TC","Microsoft JhengHei","PingFang TC",sans-serif; line-height:1.75; }
  main { max-width: 960px; margin: 0 auto; padding: 40px 24px 80px; }
  header.cover { border-bottom: 3px solid var(--accent); padding-bottom: 20px; margin-bottom: 28px; }
  h1 { font-size: 2rem; margin: 0 0 8px; }
  .meta { color: var(--muted); font-size: .92rem; }
  .intro { background: var(--card); border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 6px; }
  nav.toc ol { padding-left: 1.4em; }
  nav.toc a { color: var(--accent); text-decoration: none; }
  h2 { margin-top: 44px; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .step { margin: 22px 0 34px; break-inside: avoid; page-break-inside: avoid; }
  .step h3 { margin: 0 0 6px; font-size: 1.12rem; }
  .num { display:inline-block; min-width: 1.9em; height: 1.9em; line-height: 1.9em; text-align:center; border-radius: 50%;
         background: var(--accent); color:#fff; font-size:.9rem; margin-right:.5em; }
  .step p { margin: 6px 0 10px; }
  .step img { width: 100%; border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 2px 10px rgba(0,0,0,.06); }
  .op { font-size:.88rem; color: var(--muted); }
  .op code { background: var(--card); padding: 1px 6px; border-radius: 4px; }
  .tips { background:#fff8e6; border-left:4px solid #f5a623; padding: 12px 16px; border-radius:6px; }
  video { width:100%; border-radius: 8px; margin: 12px 0; background:#000; }
  .warn { color:#b3261e; }
  @media print { main { padding: 0 8mm; } video { display:none; } a { color: inherit; } }
</style>
</head>
<body>
<main>
<header class="cover">
  <h1>{{ title }}</h1>
  <div class="meta">適用對象：{{ audience }} · 產生時間：{{ generated }} · 系統網址：{{ url }}</div>
</header>
{% if intro %}<div class="intro">{{ intro }}</div>{% endif %}
{% if video %}<h2>教學影片</h2><video controls src="{{ video }}"></video>{% endif %}
{% if prerequisites %}<h2>開始之前</h2><ul>{% for p in prerequisites %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}
<nav class="toc"><h2>目錄</h2><ol>{% for s in sections %}<li><a href="#sec{{ loop.index }}">{{ s.title }}</a></li>{% endfor %}</ol></nav>
{% for s in sections %}
<h2 id="sec{{ loop.index }}">{{ loop.index }}. {{ s.title }}</h2>
{% if s.description %}<p>{{ s.description }}</p>{% endif %}
{% for st in s.steps %}
<div class="step">
  <h3><span class="num">{{ st.number }}</span>{{ st.title }}</h3>
  <p>{{ st.text }}</p>
  {% if st.op %}<div class="op">操作：<code>{{ st.op }}</code></div>{% endif %}
  {% if st.error %}<p class="warn">⚠ 此步驟自動執行時發生問題：{{ st.error }}</p>{% endif %}
  {% if st.image %}<img src="{{ st.image }}" alt="{{ st.title }}">{% endif %}
</div>
{% endfor %}
{% endfor %}
{% if tips %}<h2>小提醒</h2><div class="tips"><ul>{% for t in tips %}<li>{{ t }}</li>{% endfor %}</ul></div>{% endif %}
</main>
</body>
</html>
