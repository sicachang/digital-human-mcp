# ===== LLM：公司內網 Qwen（OpenAI 相容 API） =====
LLM_BASE_URL=http://172.28.26.96:9192/v1
LLM_API_KEY=EMPTY
# 留空 = 自動從 /v1/models 取得第一個模型名稱；也可填實際名稱
LLM_MODEL=
# 視覺模型（截圖理解/OCR），留空 = 與 LLM_MODEL 相同
VISION_MODEL=
USE_VISION=1
# Qwen3 思考模式（0=關閉，回應較快、JSON 較穩定）
LLM_ENABLE_THINKING=0
LLM_TIMEOUT=300
LLM_MAX_TOKENS=4096

# ===== 成果網址：填這台主機在內網可被存取的位址，工具結果才會回傳可點的連結 =====
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 專案原始碼在主機上的位置（compose 會唯讀掛載到容器 /workspace）
PROJECTS_HOST_DIR=./projects
DH_PORT=8000

# ===== 瀏覽器 =====
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
BROWSER_LOCALE=zh-TW
IGNORE_HTTPS_ERRORS=1
MAX_CONCURRENT_BROWSERS=2

# ===== 影片口白 / 字幕 =====
# piper = 內建離線中文語音（預設）｜ openai = 內網 OpenAI 相容 TTS（如 CosyVoice 閘道）｜ espeak ｜ none = 只有字幕
TTS_ENGINE=piper
# 語速：>1 變慢、<1 變快
TTS_LENGTH_SCALE=1.0
# TTS_ENGINE=openai 時使用
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=
SUBTITLE_FONT=Noto Sans CJK TC
# AI 逐字打字速度（毫秒/字）
TYPING_DELAY_MS=60
